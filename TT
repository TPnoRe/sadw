local function createToggleButton(yPos, text, settingKey)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 35); btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.TextScaled = true; btn.Font = Enum.Font.SourceSansBold; btn.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local function updateBtn()
        local enabled = settings[settingKey]
        btn.Text = text .. " : " .. (enabled and "ON" or "OFF")
        btn.BackgroundColor3 = enabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
    end
    
    btn.MouseButton1Click:Connect(function()
        settings[settingKey] = not settings[settingKey]
        updateBtn(); saveSettings(settings)
    end)
    updateBtn()
end

