Instance.new("UICorner", MinBtn)

local isTweening = false
local function toggleMinimize()
    if isTweening then return end
    isTweening = true
    settings.IsMinimized = not settings.IsMinimized
    saveSettings(settings)
    
    local targetSize = settings.IsMinimized and minSize or finalSize
    MinBtn.Text = settings.IsMinimized and "+" or "-"
    
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = targetSize
    })
    tween:Play()
    tween.Completed:Connect(function() isTweening = false end)
end

MinBtn.MouseButton1Click:Connect(toggleMinimize)

-- แอนิเมชันเปิด UI (โหลดตามสถานะย่อ/ขยาย)
