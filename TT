-- --- ส่วนที่ 1: การจัดการข้อมูลและการตั้งค่า --- --

local function loadSettings()
    local defaultSettings = {
        ZenoEnabled = false,
        VegitoEnabled = false,
        AutoCreateEnabled = false,
        Level = 1,
        PortalName = "GokuBlack"
    }
    
    if isfile and isfile(fileName) then
        local success, content = pcall(readfile, fileName)
        if success then
            local success2, data = pcall(function() return HttpService:JSONDecode(content) end)
            if success2 then
                for k, v in pairs(defaultSettings) do
                    if data[k] == nil then data[k] = v end
                end
                return data
            end
        end
    end
    return defaultSettings
end

local function saveSettings(data)
    if writefile then
        pcall(writefile, fileName, HttpService:JSONEncode(data))
    end
end

local settings = loadSettings()

-- --- ส่วนที่ 2: ฟังก์ชันช่วยและ Automation Logic --- --

local LOOP_DELAY = 1
local PROMPT_DELAY = 0.2
local ACTION_DELAY = 0.5
local WARP_OFFSET = Vector3.new(0, 0, 2)

-- ฟังก์ชัน safeRun แบบปรับปรุง (แสดงหมายเลขบรรทัดที่ Error)
local function safeRun(taskName, taskFunction, ...)
    local success, err = xpcall(taskFunction, function(message)
        return debug.traceback(message)
    end, ...)
    
    if not success then
        warn("❌ [" .. taskName .. " CRITICAL ERROR]:\n" .. tostring(err))
    end
end

local function findProximityPrompt(name)
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Name == name then
            return descendant
        end
    end
    return nil
end

local function isPromptReady(promptInstance, requireEnabled)
    if not promptInstance or not promptInstance:IsA("ProximityPrompt") then return false end
    if requireEnabled and not promptInstance.Enabled then return false end
    return true
end

-- ฟังก์ชันหลักสำหรับการกด Prompt (แก้ไข: เพิ่มการตรวจสอบ Parameter)
local function performPromptAutomation(player, promptInstance, originalCFrame, ancestorClassName)
    local originalPromptEnabled = promptInstance.Enabled
    -- ตรวจสอบความครบถ้วนของ Parameter เพื่อป้องกัน Error
    if not player or not promptInstance or not originalCFrame or not ancestorClassName then
        warn("⚠️ performPromptAutomation: Missing arguments!")
        return
    end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local promptPart = promptInstance:FindFirstAncestorWhichIsA(ancestorClassName)
    if not promptPart then
        warn("⚠️ Could not find ancestor of class: " .. tostring(ancestorClassName))
        return
    end

    -- เริ่มการทำงาน
    hrp.CFrame = promptPart.CFrame + WARP_OFFSET
    -- No additional wait needed for instant prompt activation

    if typeof(fireproximityprompt) == "function" then
        -- วนลูปยิง Prompt จนกว่า Prompt จะหายไป หรือถูกปิดใช้งาน
        while promptInstance and promptInstance.Parent and promptInstance.Enabled do
            fireproximityprompt(promptInstance)
            task.wait(PROMPT_DELAY)
        end
    end


    -- Warp back only after the prompt is no longer active
    hrp.CFrame = originalCFrame
end

-- งานย่อย 1: Zeno & Time Machine (ทำงานได้ทุกที่)
local function runZenoAndTimeMachine(player, originalCFrame)
    if not settings.ZenoEnabled then return end
    
    -- 1. กด Zeno
    local zenoPrompt = findProximityPrompt("ZenoButtonPrompt")
    if isPromptReady(zenoPrompt, true) then
        performPromptAutomation(player, zenoPrompt, originalCFrame, "MeshPart")
        task.wait(ACTION_DELAY)
    end
    
    if not settings.ZenoEnabled then return end
    
    -- 2. กด Time Machine
    local timeMachinePrompt = findProximityPrompt("TimeMachinePrompt")
    if isPromptReady(timeMachinePrompt, false) then
        local originalEnabled = timeMachinePrompt.Enabled
        timeMachinePrompt.Enabled = true
        performPromptAutomation(player, timeMachinePrompt, originalCFrame, "Part")
        timeMachinePrompt.Enabled = originalEnabled
    end
end

-- งานย่อย 2: Vegito Defense (ทำงานได้ทุกที่)
local function runVegitoDefense(player, originalCFrame)
    if not settings.VegitoEnabled then return end
    local vegitoPrompt = findProximityPrompt("VegitoDefensePrompt")
    if isPromptReady(vegitoPrompt, true) then
        -- แก้ไข: ส่งค่าให้ครบถ้วน
        performPromptAutomation(player, vegitoPrompt, originalCFrame, "BasePart")
    end
end

-- งานย่อย 3: Auto Create Portal (เฉพาะใน Lobby)
local function runAutoCreateAndStartPortal()
    if not settings.AutoCreateEnabled then return end
    if game.PlaceId ~= LOBBY_PLACE_ID then return end

    local lobbyUi = player.PlayerGui:FindFirstChild("LobbyUi")
    local knitService = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("_Index"):WaitForChild("sleitnick_knit@1.7.0"):WaitForChild("knit"):WaitForChild("Services")
    
    local function getPortalParty()
        return lobbyUi and lobbyUi:FindFirstChild("PortalParty")
    end

    local portalParty = getPortalParty()
    local isPortalReady = portalParty and portalParty.Enabled == true

    if not isPortalReady then
        while settings.AutoCreateEnabled and game.PlaceId == LOBBY_PLACE_ID do
            local itemName = settings.PortalName .. "Key" .. settings.Level
            pcall(function()
                knitService:WaitForChild("ItemService"):WaitForChild("RF"):WaitForChild("UseItem"):InvokeServer(itemName)
            end)
            
            local checkElapsed = 0
            while checkElapsed < 2 and settings.AutoCreateEnabled do
                portalParty = getPortalParty()
                if portalParty and portalParty.Enabled == true then
                    isPortalReady = true
                    break
                end
                task.wait(0.5)
                checkElapsed = checkElapsed + 0.5
            end
            if isPortalReady then break end
        end
    end
end

-- ลูปสำหรับกด Start Portal
