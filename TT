-- --- ส่วนที่ 4: ลูปหลักของ Automation --- --

task.spawn(function()
    print("🚀 ระบบ Automation แก้ไขสมบูรณ์ พร้อมทำงาน")
    while true do
        task.wait(LOOP_DELAY)
        
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            local originalCFrame = hrp.CFrame
            
            if settings.ZenoEnabled then
                safeRun("Zeno/TimeMachine", runZenoAndTimeMachine, player, originalCFrame)
            end
            if settings.VegitoEnabled then
                safeRun("VegitoDefense", runVegitoDefense, player, originalCFrame)
            end
            if settings.AutoCreateEnabled and game.PlaceId == LOBBY_PLACE_ID then
                safeRun("AutoCreateAndStartPortal", runAutoCreateAndStartPortal)
            end
        end
    end
end)
