-- --- ส่วนที่ 4: Main Loop --- --
task.spawn(function()
    print("🚀 สคริปต์เริ่มทำงาน (Minimize Support)")
    while not shouldStop() do
        task.wait(LOOP_DELAY)
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        if game.PlaceId ~= LOBBY_PLACE_ID then
            local targetPos = Vector3.new(218, 6, -6813)
            if (hrp.Position - targetPos).Magnitude > 15 then
                hrp.CFrame = CFrame.new(targetPos)
                task.wait(0.5)
            end
        end
        local originalCFrame = hrp.CFrame
        if settings.ZenoEnabled then safeRun("Zeno", runZeno, originalCFrame) end
        if shouldStop() then break end
        if settings.VegitoEnabled then safeRun("Vegito", runVegito, originalCFrame) end
        if shouldStop() then break end
        if settings.AutoCreateEnabled and game.PlaceId == LOBBY_PLACE_ID then
            local lobbyUi = player.PlayerGui:FindFirstChild("LobbyUi")
            local portalParty = lobbyUi and lobbyUi:FindFirstChild("PortalParty")
            if not (portalParty and portalParty.Enabled) then
                local itemName = settings.PortalName .. "Key" .. settings.Level
                pcall(function()
                    local knit = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("_Index"):WaitForChild("sleitnick_knit@1.7.0"):WaitForChild("knit"):WaitForChild("Services")
                    knit:WaitForChild("ItemService"):WaitForChild("RF"):WaitForChild("UseItem"):InvokeServer(itemName)
                end)
            else
                pcall(function()
                    local knit = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("_Index"):WaitForChild("sleitnick_knit@1.7.0"):WaitForChild("knit"):WaitForChild("Services")
                    knit:WaitForChild("PortalService"):WaitForChild("RF"):WaitForChild("StartPortal"):InvokeServer()
                end)
            end
        end
    end
end)
