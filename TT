local function getKnitService(serviceName)
    local success, result = pcall(function()
        local services = ReplicatedStorage:FindFirstChild("Services", true) or 
                         ReplicatedStorage:FindFirstChild("knit", true):FindFirstChild("Services", true)
        if services then return services:FindFirstChild(serviceName) end
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if (v.Name == serviceName) and (v:IsA("ModuleScript") or v:IsA("RemoteFunction") or v:IsA("Folder")) then
                return v
            end
        end
        return nil
    end)
    return success and result or nil
end

local promptCache = {}
local lastFullSearch = 0
local SEARCH_INTERVAL = 10

local function findProximityPrompt(name)
    if promptCache[name] and promptCache[name].Parent then return promptCache[name] end
    local found = Workspace:FindFirstChild(name, true)
    if found and found:IsA("ProximityPrompt") then
        promptCache[name] = found
        return found
    end
    if tick() - lastFullSearch > SEARCH_INTERVAL then
        lastFullSearch = tick()
        for _, descendant in ipairs(Workspace:GetDescendants()) do
            if descendant:IsA("ProximityPrompt") and descendant.Name == name then
                promptCache[name] = descendant
                return descendant
            end
        end
    end
    return nil
end

local function isPromptReady(promptInstance, requireEnabled)
    if not promptInstance or not promptInstance:IsA("ProximityPrompt") then return false end
    if requireEnabled and not promptInstance.Enabled then return false end
    return true
end

local function safeRun(taskName, taskFunction, ...)
    local success, err = xpcall(taskFunction, function(message) return debug.traceback(message) end, ...)
    if not success then 
        addLogOnce("error_" .. taskName, "❌ " .. taskName .. " Error: " .. tostring(err), Color3.new(1,0,0)) 
    end
    return success
end

local function performPromptAutomation(promptInstance, originalCFrame, ancestorClassName)
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp or not promptInstance then return end
    local promptPart = promptInstance:FindFirstAncestorWhichIsA(ancestorClassName)
    if not promptPart then return end
    
    addLog("🌀 กำลังทำงาน: " .. promptInstance.Name, Color3.new(0.5, 1, 1))
    hrp.CFrame = promptPart.CFrame + WARP_OFFSET
    task.wait(PROMPT_DELAY)
    if typeof(fireproximityprompt) == "function" then 
        fireproximityprompt(promptInstance) 
    end
    task.wait(PROMPT_DELAY)
    hrp.CFrame = originalCFrame
end

local function runZeno(originalCFrame)
    if not settings.ZenoEnabled then return end
    local zenoPrompt = findProximityPrompt("ZenoButtonPrompt")
    if isPromptReady(zenoPrompt, true) then
        addLog("🌀 กดปุ่ม Zeno...", Color3.new(0.3, 0.8, 1))
        performPromptAutomation(zenoPrompt, originalCFrame, "MeshPart")
        task.wait(ACTION_DELAY)
    end
    if shouldStop() or not settings.ZenoEnabled then return end
    local timeMachinePrompt = findProximityPrompt("TimeMachinePrompt")
    if isPromptReady(timeMachinePrompt, false) then
        addLog("⏳ กดปุ่ม Time Machine...", Color3.new(1, 0.8, 0.3))
        local old = timeMachinePrompt.Enabled
        timeMachinePrompt.Enabled = true
        performPromptAutomation(timeMachinePrompt, originalCFrame, "Part")
        timeMachinePrompt.Enabled = old
    end
end

local function runVegito(originalCFrame)
    if not settings.VegitoEnabled then return end
    local vegitoPrompt = findProximityPrompt("VegitoDefensePrompt")
    if isPromptReady(vegitoPrompt, true) then 
        addLog("⚔️ กดปุ่ม Vegito...", Color3.new(0.3, 1, 0.3))
        performPromptAutomation(vegitoPrompt, originalCFrame, "BasePart") 
    end
end

local lastPortalActionTime = 0
local PORTAL_ACTION_COOLDOWN = 5

local function handleAutoCreatePortal()
    local portalParty = player.PlayerGui:FindFirstChild("PortalParty", true)
    local isPortalActive = portalParty and (portalParty.Enabled or (portalParty:IsA("Frame") and portalParty.Visible))
    
    if not isPortalActive then
        if tick() - lastPortalActionTime < PORTAL_ACTION_COOLDOWN then return end
        local itemName = settings.PortalName .. "Key" .. settings.Level
        local itemService = getKnitService("ItemService")
        if itemService then
            local rf = itemService:FindFirstChild("UseItem", true)
            if rf then
                addLog("🛠️ กำลังสร้าง Portal: " .. itemName, Color3.new(0.5, 0.8, 0.5))
                local success, err = pcall(function() rf:InvokeServer(itemName) end)
                if success then lastPortalActionTime = tick() end
            end
        end
        task.wait(1.5)
    else
        if tick() - lastPortalActionTime < PORTAL_ACTION_COOLDOWN then return end
        local portalService = getKnitService("PortalService")
        if portalService then
            local rf = portalService:FindFirstChild("StartPortal", true)
            if rf then
                addLog("🚀 กำลังเริ่ม Portal...", Color3.new(0, 1, 1))
                local success, err = pcall(function() rf:InvokeServer() end)
                if success then lastPortalActionTime = tick() end
            end
        end
        task.wait(2.5)
    end
end

