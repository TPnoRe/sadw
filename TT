-- --- ส่วนที่ 1: การจัดการข้อมูลและการตั้งค่า --- --
local fileName = "AutoPromptSettings_FinalFix.json"
local function loadSettings()
    local defaultSettings = {
        ZenoEnabled = false,
        VegitoEnabled = false,
        AutoCreateEnabled = false,
        Level = 1,
        PortalName = "GokuBlack",
        GuiPos = {X = 0.5, XOffset = -90, Y = 0.5, YOffset = -130},
        IsMinimized = false -- เพิ่มสถานะย่อหน้าจอ
    }
    if isfile and isfile(fileName) then
        local success, content = pcall(readfile, fileName)
        if success then
            local success2, data = pcall(function() return HttpService:JSONDecode(content) end)
            if success2 then
                for k, v in pairs(defaultSettings) do
                    if data[k] == nil then data[k] = v end
                end
                return data
            end
        end
    end
    return defaultSettings
end

local function saveSettings(data)
    if writefile then pcall(writefile, fileName, HttpService:JSONEncode(data)) end
end

local settings = loadSettings()

-- --- ส่วนที่ 2: ฟังก์ชันช่วยและ Automation Logic --- --
local LOOP_DELAY = 1
local PROMPT_DELAY = 0.2
local ACTION_DELAY = 0.5
local WARP_OFFSET = Vector3.new(0, 0, 2)
local LOBBY_PLACE_ID = 133410800847665

local promptCache = {}
local lastFullSearch = 0
local SEARCH_INTERVAL = 10

local function findProximityPrompt(name)
    if promptCache[name] and promptCache[name].Parent then return promptCache[name] end
    local found = Workspace:FindFirstChild(name, true)
    if found and found:IsA("ProximityPrompt") then
        promptCache[name] = found
        return found
    end
    if tick() - lastFullSearch > SEARCH_INTERVAL then
        lastFullSearch = tick()
        for _, descendant in ipairs(Workspace:GetDescendants()) do
            if descendant:IsA("ProximityPrompt") and descendant.Name == name then
                promptCache[name] = descendant
                return descendant
            end
        end
    end
    return nil
end

local function isPromptReady(promptInstance, requireEnabled)
    if not promptInstance or not promptInstance:IsA("ProximityPrompt") then return false end
    if requireEnabled and not promptInstance.Enabled then return false end
    return true
end

local function safeRun(taskName, taskFunction, ...)
    local success, err = xpcall(taskFunction, function(message) return debug.traceback(message) end, ...)
    if not success then warn("❌ [" .. taskName .. " ERROR]: " .. tostring(err)) end
end

local function performPromptAutomation(promptInstance, originalCFrame, ancestorClassName)
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp or not promptInstance then return end
    local promptPart = promptInstance:FindFirstAncestorWhichIsA(ancestorClassName)
    if not promptPart then return end
    hrp.CFrame = promptPart.CFrame + WARP_OFFSET
    task.wait(PROMPT_DELAY)
    if typeof(fireproximityprompt) == "function" then fireproximityprompt(promptInstance) end
    task.wait(PROMPT_DELAY)
    hrp.CFrame = originalCFrame
end

local function runZeno(originalCFrame)
    if not settings.ZenoEnabled then return end
    local zenoPrompt = findProximityPrompt("ZenoButtonPrompt")
    if isPromptReady(zenoPrompt, true) then
        performPromptAutomation(zenoPrompt, originalCFrame, "MeshPart")
        task.wait(ACTION_DELAY)
    end
    if shouldStop() or not settings.ZenoEnabled then return end
    local timeMachinePrompt = findProximityPrompt("TimeMachinePrompt")
    if isPromptReady(timeMachinePrompt, false) then
        local old = timeMachinePrompt.Enabled
        timeMachinePrompt.Enabled = true
        performPromptAutomation(timeMachinePrompt, originalCFrame, "Part")
        timeMachinePrompt.Enabled = old
    end
end

local function runVegito(originalCFrame)
    if not settings.VegitoEnabled then return end
    local vegitoPrompt = findProximityPrompt("VegitoDefensePrompt")
    if isPromptReady(vegitoPrompt, true) then performPromptAutomation(vegitoPrompt, originalCFrame, "BasePart") end
end

