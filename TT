-- ระบบ Log บนหน้าจอ (Defined early to ensure all logs work)
local logEntries = {}
local MAX_LOGS = 5
local logContainer

local function addLog(text, color)
    if not logContainer then 
        print("[LOG - Pre-GUI]: " .. text)
        return 
    end
    color = color or Color3.new(1,1,1)
    table.insert(logEntries, {text = text, color = color})
    if #logEntries > MAX_LOGS then table.remove(logEntries, 1) end
    
    local fullText = ""
    for i, entry in ipairs(logEntries) do
        fullText = fullText .. entry.text .. "\n"
    end
    logContainer.Text = fullText
    print("[LOG]: " .. text)
end

local lastLoggedState = {}
local function addLogOnce(key, text, color)
    if lastLoggedState[key] ~= text then
        addLog(text, color)
        lastLoggedState[key] = text
    end
end

