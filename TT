local isTweening = false
local function toggleMinimize()
    if isTweening then return end
    isTweening = true
    settings.IsMinimized = not settings.IsMinimized
    MinBtn.Text = settings.IsMinimized and "+" or "-"
    local targetSize = settings.IsMinimized and minSize or finalSize
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize})
    tween:Play()
    tween.Completed:Connect(function() 
        isTweening = false 
        saveSettings(settings)
    end)
end
