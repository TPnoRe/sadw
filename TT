ScreenGui.Name = "AutoPromptGui_FinalFix"
ScreenGui.Parent = player:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 220, 0, 320)
MainFrame.Position = UDim2.new(0, 20, 0, 20)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 2

local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Text = "Fixed Automation"
Title.TextColor3 = Color3.new(1,1,1)
Title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Title.TextScaled = true
Title.Font = Enum.Font.SourceSansBold

local function createToggleButton(name, yPos, text, settingKey)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Name = name
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    btn.TextColor3 = Color3.new(1,1,1)
    
    local function updateBtn()
        local enabled = settings[settingKey]
        btn.Text = text .. " : " .. (enabled and "ON" or "OFF")
        btn.BackgroundColor3 = enabled and Color3.fromRGB(0, 180, 0) or Color3.fromRGB(180, 0, 0)
    end
    
    btn.MouseButton1Click:Connect(function()
        settings[settingKey] = not settings[settingKey]
        if settingKey == "AutoCreateEnabled" and settings[settingKey] == false then
            leavePortal()
        end
        updateBtn()
        saveSettings(settings)
    end)
    
    updateBtn()
    return btn
end

createToggleButton("ZenoToggle", 50, "Zeno / TM", "ZenoEnabled")
createToggleButton("VegitoToggle", 100, "Vegito Defense", "VegitoEnabled")
createToggleButton("AutoCreateToggle", 150, "Auto Create & Start", "AutoCreateEnabled")

local LevelDisplay = Instance.new("TextLabel", MainFrame)
LevelDisplay.Size = UDim2.new(0.4, 0, 0, 30); LevelDisplay.Position = UDim2.new(0.3, 0, 0, 200)
LevelDisplay.Text = "Level "..tostring(settings.Level); LevelDisplay.TextColor3 = Color3.new(1,1,1); LevelDisplay.BackgroundTransparency = 1; LevelDisplay.TextScaled = true

local function updateLevel(delta)
    settings.Level = math.clamp(settings.Level + delta, 1, 4)
    LevelDisplay.Text = "Level "..tostring(settings.Level); saveSettings(settings)
end

local PrevLvl = Instance.new("TextButton", MainFrame)
PrevLvl.Size = UDim2.new(0.1, 0, 0, 30); PrevLvl.Position = UDim2.new(0.15, 0, 0, 200); PrevLvl.Text = "<"
PrevLvl.MouseButton1Click:Connect(function() updateLevel(-1) end)

local NextLvl = Instance.new("TextButton", MainFrame)
NextLvl.Size = UDim2.new(0.1, 0, 0, 30); NextLvl.Position = UDim2.new(0.75, 0, 0, 200); NextLvl.Text = ">"
NextLvl.MouseButton1Click:Connect(function() updateLevel(1) end)

local PortalInput = Instance.new("TextBox", MainFrame)
